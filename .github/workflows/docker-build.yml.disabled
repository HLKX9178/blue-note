name: Build & Push Docker Images

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build-and-push:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
          - service: gateway
            dockerfile: bluenote-gateway/Dockerfile
            image: bluenote-gateway
          - service: auth
            dockerfile: bluenote-auth/Dockerfile
            image: bluenote-auth
          - service: oss
            dockerfile: bluenote-oss/bluenote-oss-biz/Dockerfile
            image: bluenote-oss
          - service: user
            dockerfile: bluenote-user/bluenote-user-biz/Dockerfile
            image: bluenote-user
          - service: kv
            dockerfile: bluenote-kv/bluenote-kv-biz/Dockerfile
            image: bluenote-kv
          - service: id
            dockerfile: bluenote-distributed-id-generator/bluenote-distributed-id-generator-biz/Dockerfile
            image: bluenote-id
          - service: note
            dockerfile: bluenote-note/bluenote-note-biz/Dockerfile
            image: bluenote-note
          - service: relation
            dockerfile: bluenote-user-relation/bluenote-user-relation-biz/Dockerfile
            image: bluenote-user-relation
          - service: count
            dockerfile: bluenote-count/bluenote-count-biz/Dockerfile
            image: bluenote-count
          - service: data-align
            dockerfile: bluenote-data-align/Dockerfile
            image: bluenote-data-align
          - service: search
            dockerfile: bluenote-search/Dockerfile
            image: bluenote-search
          - service: comment
            dockerfile: bluenote-comment/bluenote-comment-biz/Dockerfile
            image: bluenote-comment

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to Docker Hub
        uses: docker/login-action@v4
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Docker metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ secrets.DOCKERHUB_USERNAME }}/${{ matrix.image }}
          tags: |
            type=sha,prefix=
            type=raw,value=latest,enable={{is_default_branch}}

      - name: Build & Push
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ${{ matrix.dockerfile }}
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha,scope=${{ matrix.service }}
          cache-to: type=gha,mode=max,scope=${{ matrix.service }}
